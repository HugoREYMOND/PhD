@article{Choi2022,
   abstract = {The atomization of a water column by a gas jet flow (Reynolds number $\sim O(10^\{4\}\unicode\{x2013\}10^\{5\})$ ) issued from a two-stage annular nozzle is investigated experimentally. Varying the nozzle geometry, the momentum flux ratio of the upper and lower jets, and the water flow rate, we measure the processes of atomization with high-speed imaging, analysed analytically into four regimes. In the bulk atomization regime, the atomization is driven by the lower jet, but it is forced to occur earlier by the stronger upper jet before the water column reaches the lower jet in the droplet atomization regime. Interestingly, the size of the atomized droplets remains unaffected by the momentum flux ratio of upper to lower jets. The atomization process is governed by the Rayleigh–Taylor instability, by which the estimated droplet size agrees well with the measurement. In the backflow regime, a strong reverse flow is induced to force a substantial portion of atomized droplets to be drawn backward to the nozzle; a floating liquid column regime is captured transitionally, i.e. the column stagnates near the lower nozzle when the water flow rate is very low. To understand the mechanisms of each regime, the single-phase jet flow is measured separately using particle image velocimetry, and implemented into the control volume analysis with which we predicted analytically and validated the conditions for the occurrence of each regime. It is found that the acceleration of gas flow (velocity gradient) experienced by the falling water is the key parameter to drive the atomization.},
   author = {Daehyun Choi and Jungwon Byun and Hyungmin Park},
   doi = {10.1017/jfm.2022.435},
   journal = {Journal of Fluid Mechanics},
   title = {Analysis of liquid column atomization by annular dual-nozzle gas jet flow},
   volume = {943},
   url = {https://www.cambridge.org/core/services/aop-cambridge-core/content/view/9D6FF67346987DF34A49077B57480885/S0022112022004359a.pdf/div-class-title-analysis-of-liquid-column-atomization-by-annular-dual-nozzle-gas-jet-flow-div.pdf},
   year = {2022}
}
@article{Ting2002,
   abstract = {The relationship between melt ﬂow rates, gas-only aspiration of the atomizer nozzle and operating pressures are elusive, and most often these parameters are interdependent. The understanding of these interactions, however, is crucial to the efﬁcient production of ﬁne metal powder. Atomization yield above and below a condition known as wake closure pressure can produce median powder size (D50) variation as large as 42%. Here, a pulsatile atomization model is presented to elucidate the interaction between the atomizing gas and the melt around the melt pour tube. The model reveals that melt ﬂow rate is determined by the time-averaged stagnation pressure formed in front of the melt oriﬁce. This stagnation front dictates the behavior of the melt exiting the melt oriﬁce and how it interacts with the atomizing gas. It is noted, however, that the wake-closure phenomenon is highly sensitive to atomizer and melt pour tube geometry and it possesses a hysteresis type aspiration behavior that suggests that there is an energy of formation associated with the wake-closure structure. Furthermore, the atomizing gas has to possess the necessary energy to overcome this energy barrier in order to form the wake closure structure. Concurrently, the entropy of the system increases with the formation of Mach disk and oblique shocks, leading to a lower equilibrium state for the gas dynamics. © 2002 Elsevier Science B.V. All rights reserved.},
   author = {Jason Ting and Michael W Peretti and William B Eisen},
   doi = {10.1016/S0921-5093(01)01437-X},
   issn = {09215093},
   issue = {1},
   journal = {Materials Science and Engineering: A},
   pages = {110-121},
   title = {The effect of wake-closure phenomenon on gas atomization performance},
   volume = {326},
   url = {https://linkinghub.elsevier.com/retrieve/pii/S092150930101437X https://pdf.sciencedirectassets.com/271387/1-s2.0-S0921509300X01177/1-s2.0-S092150930101437X/main.pdf?X-Amz-Security-Token=IQoJb3JpZ2luX2VjELH%2F%2F%2F%2F%2F%2F%2F%2F%2F%2FwEaCXVzLWVhc3QtMSJHMEUCIFaA1gK62xKyrC5Yl5HFQ3z6yMfsWPIV8nnlvXdEtKdvAiEAtW68OsgFGuEGFuloRsQ3XRIgvTdlzDIqziiaLh883hAqswUIeRAFGgwwNTkwMDM1NDY4NjUiDCMrpN9IrXH5iFixayqQBUxfVN7B%2B%2FMMszNXNvDQiz6hlnzK9JTwVReVFo0YZnuJJOh9QZAsGQ4k4y%2Bak6AQnBaCRp%2BjKKPUS4aKW1VKlLgorU2YorxQifDyxnikgx%2FxShhn6oBIDIV4k04EeK8AaPgy6pliwozs%2BEj0MV0ymHRiTbkOwvaY8fLHg5nRPXkP%2BjaKBec%2F1fY%2BnxPX76txnqjKj3x33r0GfxHN4j1mH6xl8Kba%2F2PbLtuotDwlLW3pxfS25jMsO1pPq96D4fuhe7wJInrXHE44lLwm3woqTklQ8B3LnPcEMAS9Jk%2Bg%2FfJgmL57GVgtNl0pOREpZnDUr2OD9LjvRkt0Ob5z2aezRpN5BKW4hsF%2BSs1sFmrH4wCTnRdVq695RsJp6zT8le8csoNkt1O7PDA2ewsOMBttRFTyvZmsCgjhCtSxXFa9tm9Yk3cpP3IswVCPV7dbtREKy9rp4gsPVb7uWaF6dlpMpmsQwyG1%2F8zfpayCPiW4obYbUtXAqY0vQzMHr4vEBOTeVro9aQ6r%2FJvLwlOpl%2BwJDwli4BbMCW22r%2B8flwTzyYl3p6%2FnIPVbDwGF0XEW6GfMowV1BlSCpH7Htey2ovSfZ0IqPkOGB6R37Ap25SVtVJWxHWgp6VorzsDV1Dl6JTQEaIijRHpk%2FiBQkCpCGEA1uHilE2d0cnoFdwt7KpU28hrSTO6nsYOsB1k0EYdfbleYh4%2BHFjJocgmoybBBlO61v0dT0z%2FlrA5%2BlHp9pEyHfU0qCBwNJJtKkajJ6lj5X6Q4KyWpQNQjeSyzOegxskQmyQSeEVEfWgdawofGMwXMTvCPeX37FCGzp2U5MKJDhjFsNU1vmCoNN9%2Fx6ctq5Dn8eO2ZNiN%2B7Py890Um2jSeFbtuMKzPrM8GOrEBNcVuLL1Dh14GcOXmqL6eFsacJYerGjYuh%2Bljr4NPllodF%2BpxqZ0a7YbWACGgas5pggMAheHEKkGUrCa%2FFeOUVxdas96oSyJXwdVqZh4F%2Bs9MKXlBeIBoSMmf2txH5hM0mNcvA2eqxMcscLuCIcIPsT6VKDQ2XRNt3f7DWnFZV0Vq65hN0kNaYYx%2Fv6N0ny8t%2BK3N5uC0ZDlAFUxRQHakSZyY2r1cIg940oziaudA%2BA8x&X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Date=20260424T090848Z&X-Amz-SignedHeaders=host&X-Amz-Expires=300&X-Amz-Credential=ASIAQ3PHCVTYQN6DG6IL%2F20260424%2Fus-east-1%2Fs3%2Faws4_request&X-Amz-Signature=4bbe1fbc23535aae1e294d6501f9f88525c2d515d553bb36b5c3ca8bad3a408f&hash=15e08ceb6d7a87770429ddab8b8f41f8d95566dc2b2bbca5d3d7b63278cd59b1&host=68042c943591013ac2b2430a89b270f6af2c76d8dfd086a07176afe7c76c2c61