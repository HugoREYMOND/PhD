@article{Zerwas2024,
   abstract = {Metal powders for additive manufacturing (AM) are typically produced by atomizing metal melts. In this study, different spray configurations for producing particles for AM are analyzed. Two close-coupled gas-assisted atomizers (CCA) are compared for the atomization of hot working tool steel (AISI H13), namely discrete jets and annular slit nozzles. High-speed image analysis of the oscillations in the liquid spray indicated that the flapping behavior resulted in higher number of off-spec particles (flakes), which were related to the gas-to-melt ratio (GMR). This behavior was observed for both configurations, but flapping oscillations at lower GMR and a super pulsating mode at higher GMR, were identified for the annular slit nozzle. The use of hot atomizer gas resulted in an increase of the fine powder yield suitable for laser powder bed fusion (L-PBF), but at the expense of an increasing satellite particles, which may cause difficulties in powder flow during printing operations.},
   author = {Alexander Ariyoshi Zerwas and Flávia Costa da Silva and Roberto Guardani and Lydia Achelis and Udo Fritsching},
   doi = {10.1016/j.powtec.2024.119974},
   issn = {0032-5910},
   journal = {Powder Technology},
   keywords = {AISI H13,Additive manufacturing,Gas atomization,High-speed image analysis,Metal powder characterization,Primary liquid fragmentation},
   pages = {119974},
   title = {Impact of the gas atomizer nozzle configuration on metal powder production for additive manufacturing},
   volume = {443},
   url = {https://www.sciencedirect.com/science/article/pii/S003259102400617X https://pdf.sciencedirectassets.com/271376/1-s2.0-S0032591024X00091/1-s2.0-S003259102400617X/main.pdf?X-Amz-Security-Token=IQoJb3JpZ2luX2VjEFAaCXVzLWVhc3QtMSJHMEUCID2lTWSIXlccV1cpRykpnGiv14aKw6gRys0MFCdUQH1tAiEAsqFpt%2F2J5KVqMs5PeLc2FQlGuNAirxdJS%2F1RWAGHDUUqswUIGRAFGgwwNTkwMDM1NDY4NjUiDIJSb0if02fJWBUociqQBXMs5ZWF66NLKINg6LSuNkhp7O91y1YB0GW7yHKzwrd%2FP06vUI9SaprXgZaCOQE7eJbsv3HQ37asGXcS%2FdiQmgqxqVDg8c1Eb0371AgddE7wJEvb5BAG%2FUGexsRTn%2Fs5SNin35C5WbUPx%2B65vX1%2F%2B5hgqaK%2FiP3YWXpJaF9%2BSd%2BX2K9GhPvtEZa7dsT8e4RAP%2FB6h1qBCfNeJnTyGJ3BmTzXPm0QFWX%2B%2BPUMGcqJkeZj1RudLEQbPbw2Xgil6ljaHEq4rdQf8E%2B5YoGNElHdThsIL3pqFaU6b0x707EBOkOzOkQ%2FulgnuwyjXpMxibPerL%2BgCkGazUq8gC7FKjY2b2vJzL5U6kfzyBZC9zAEIWOLpuuDMRAm%2Fsd7AhX05wrXnF%2FLOlFMVV3NM087lOLVCc17kUwsCqKVnNo8YIX8an2ECNkGdKBQzxQpNhvZbNcpPVK8hWCnSrbxFYNRZ9C%2BIJc6gVJaDy4Ak71INIbtx5WgLSfUGqQmuCqoDpytRJsjmTakR7Epb4nKFx3kIY2deEPXNnCGQKfvalCN%2BAiyM5AFMrhydm%2BvV7nuZUzSVq%2Fm6GxNN4HYVRqSGGkJAwoxhLZ%2FhLbtQdTHyN9o1Em9LzgAfWiop%2BfrA05GuN1TvlzcnPOGkhWqqYTUljx8TtMAodH4ss7tlowu9FDf8827EWHj4zRY5ItV1NBT40bMfaahTb1ND4SmIltDXmLmkGlafn%2BPZ2kFjSxfSXGk8TDYh%2FzyjkoCgRV0WPDeYguh9KBy9FdKKIJPHGT6Zo7XXesz0Q%2FPXg%2B%2B34TFsDHfExkhGzc8fhRz1WSSJHzg3koB8PGpFvCUULoXuK9mp9AD%2FT1dxNh9AXdMGbsog2nKn%2Bey0ftvMK%2BI384GOrEB8MaN%2Fs4L4D6TpzkGfW7%2BArZyr%2BBK20il%2Fw1Qwh0gpiDu9aHcn9OYVqw7f5L7wy90qmp3TQdkSJ1rQ8sHbeC8LVANxUdx27EIiA70reHn6H33a0wAZhTqPOniTQIajQdasf%2FNmg2LqEoBhXyzTN0ab%2BFPTV%2BmYb%2BQXHo8I7zpzfjcycGz3M%2B3FJ48Mgw4m0pQC2Qa44Za8SaEPzCmG%2BM6D8jiNsMkX%2FdVXFJfvpSZS1NY&X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Date=20260409T161541Z&X-Amz-SignedHeaders=host&X-Amz-Expires=300&X-Amz-Credential=ASIAQ3PHCVTYZZROLEVO%2F20260409%2Fus-east-1%2Fs3%2Faws4_request&X-Amz-Signature=cca9f65082bc8f5234a9415ecdacc91d0aaaadb4182d8efc6d88e4628d83767c&hash=25acbf8748adc7aef723ea5019eef33d5d250c299cfc3291d312ae9bbca9d8d4&host=68042c943591013ac2b2430a89b270f6af2c76d8dfd086a07176afe7c76c2c6